e":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enqueue","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/Statoscope\/documentation\/Statoscope\/EffectsState\/enqueue(_:)","abstract":[{"text":"Enqueues an effect to be triggered. The provided effect must return a new When case","type":"text"}],"title":"enqueue(_:)","kind":"symbol","url":"\/documentation\/statoscope\/effectsstate\/enqueue(_:)"},"doc://Statoscope/documentation/Statoscope/EffectsState":{"url":"\/documentation\/statoscope\/effectsstate","identifier":"doc:\/\/Statoscope\/documentation\/Statoscope\/EffectsState","type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"EffectsState","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EffectsState","kind":"identifier"}],"title":"EffectsState","abstract":[{"type":"text","text":"Responsible of controlling a group of effects, all they having a common return object type When."},{"type":"text","text":" "},{"type":"text","text":"This struct is meant for communication between an update of your app’s state and the trigger of"},{"type":"text","text":" "},{"type":"text","text":"the appropriate effects. Simply defines the current ongoing effects providing an snapshot,"},{"type":"text","text":" "},{"type":"text","text":"and provides functions to enqueue new effects or cancel existing ones."}]}}}