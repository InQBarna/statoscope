Voice","code":"ParentState"},{"type":"text","text":" ← "},{"type":"codeVoice","code":"ChildState"},{"type":"text","text":" "},{"type":"text","text":"forms a cycle when both use plain stored value types). The closure captures a copy of"},{"type":"text","text":" "},{"type":"text","text":"the parent state by value — not a reference — so "},{"type":"codeVoice","code":"update()"},{"type":"text","text":" remains a pure function."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The property is "},{"type":"strong","inlineContent":[{"text":"read-only","type":"text"}]},{"type":"text","text":": assigning "},{"code":"state.parent = ...","type":"codeVoice"},{"type":"text","text":" is a compile-time error,"},{"type":"text","text":" "},{"type":"text","text":"enforcing the pattern that only the parent reducer mutates parent state."}]},{"type":"heading","level":2,"text":"Usage:","anchor":"Usage"},{"syntax":"swift","type":"codeListing","code":["@Reducer","struct ChildReducer {","    struct State {","        @SuperState var parent: ParentReducer.State","        var value: Int = 0","    }","","    static func update(_ when: When, state: inout State, ...) throws {","        state.value = state.parent.count * 2  \/\/ read-only snapshot access","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Value"},{"type":"text","text":" must conform to "},{"type":"codeVoice","code":"Injectable"},{"type":"text","text":" so the framework can produce a default when"},{"type":"text","text":" "},{"type":"text","text":"the child store is not yet wired to a parent."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/statoscope\/superstate"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Statoscope\/documentation\/Statoscope"]]},"metadata":{"externalID":"s:10Statoscope10SuperStateV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuperState","kind":"identifi