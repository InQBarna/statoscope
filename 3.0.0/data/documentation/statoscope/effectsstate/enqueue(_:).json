lete with an appropriate When case"}]}],"name":"effect"}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Please note enqueueing an effect is just adding it to a list of pending effects. Does not","type":"text"},{"text":" ","type":"text"},{"text":"immediately trigger it. However EffectsState is provided in the update method and right","type":"text"},{"text":" ","type":"text"},{"text":"after method is completed, the enqueued effects will be triggered","type":"text"}]},{"level":3,"anchor":"Usage","type":"heading","text":"Usage"},{"type":"paragraph","inlineContent":[{"text":"Use it with an anonymous Effect","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["effectsController.enqueue(","  AnyEffect {","    let resultDTO = try JSONDecoder().decode(DTO.self, from: try await URLSession.shared.data(for: request).0)","    return When.networkPostCompleted(resultDTO)","  }",")"]},{"type":"paragraph","inlineContent":[{"text":"Or created a typed Effect","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct NetworkEffect<Response: Decodable>: Effect {","  let request: URLRequest","  func runEffect() async throws -> Response {","    try JSONDecoder().decode(Response.self, from: try await URLSession.shared.data(for: request).0)","  }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"And use it mapping the result to your When case"}]},{"syntax":"swift","type":"codeListing","code":["effectsController.enqueue(","  let url = URL(string: \"http:\/\/statoscope.com\")!","  var request = URLRequest(url: url)","  request.setValue(\"application\/json\", forHTTPHeaderField: \"Content-Type\")","  request.httpMethod = \"POST\"","  request.httpBody = try JSONEncoder().encode(dto)","  return NetworkEffect(request)","     .map(When.networkPostCompleted)",")"]}]}],"sections":[],"metadata":{"role":"symbol","modules":[{"name":"Statoscope"}],"externalID":"