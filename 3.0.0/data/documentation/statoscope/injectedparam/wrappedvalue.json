ind":"symbol","title":"Statoscope"},"doc://Statoscope/documentation/Statoscope/InjectedParam":{"kind":"symbol","title":"InjectedParam","url":"\/documentation\/statoscope\/injectedparam","type":"topic","identifier":"doc:\/\/Statoscope\/documentation\/Statoscope\/InjectedParam","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"InjectedParam"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"InjectedParam"}],"abstract":[{"type":"text","text":"Marks an "},{"type":"codeVoice","code":"@EffectStruct"},{"type":"text","text":" function parameter as resolved from the injection tree (via"},{"type":"text","text":" "},{"type":"codeVoice","code":"@InjectedForEffect"},{"type":"text","text":" on the generated struct) rather than stored\/compared as an ordinary"},{"type":"text","text":" "},{"type":"text","text":"parameter. Purely a marker at the call site — "},{"type":"codeVoice","code":"wrappedValue"},{"type":"text","text":" is never read for anything but"},{"type":"text","text":" "},{"type":"text","text":"passthrough. Always takes an "},{"type":"codeVoice","code":"Injectable"},{"type":"text","text":" type ("},{"type":"codeVoice","code":"SomeType.self"},{"type":"text","text":") — the macro reads it from the"},{"type":"text","text":" "},{"type":"text","text":"attribute’s own source text to generate the struct’s property, never from this wrapper’s"},{"type":"text","text":" "},{"type":"text","text":"runtime state, so the argument here only needs to make "},{"type":"codeVoice","code":"@InjectedParam(SomeType.self) name: T"},{"type":"text","text":" "},{"type":"text","text":"valid Swift at the function declaration (SE-0293 property wrappers on parameters support this)."}]}}}