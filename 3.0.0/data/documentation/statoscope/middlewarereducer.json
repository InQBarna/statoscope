{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MiddlewareReducer"}]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"When a Reducer conforms to ","type":"text"},{"code":"MiddlewareReducer","type":"codeVoice"},{"text":", the generated Store class will implement","type":"text"},{"text":" ","type":"text"},{"code":"HierarchialScopeMiddleWare","type":"codeVoice"},{"text":" and observe events from child scopes.","type":"text"}]},{"inlineContent":[{"code":"updateSubstate","type":"codeVoice"},{"type":"text","text":" runs "},{"type":"strong","inlineContent":[{"text":"after","type":"text"}]},{"text":" the child’s own ","type":"text"},{"code":"update()","type":"codeVoice"},{"text":" has already processed the event —","type":"text"},{"text":" ","type":"text"},{"code":"childState","type":"codeVoice"},{"text":" is the child’s state once that update finished, not a preview of what’s about","type":"text"},{"text":" ","type":"text"},{"text":"to happen. This mirrors ","type":"text"},{"type":"codeVoice","code":"statoscope-zustand"},{"text":"‘s ","type":"text"},{"type":"codeVoice","code":"onChildAction(action, childState)"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"documents the same thing: “called with the action and the child’s already-updated state.”","type":"text"},{"text":" ","type":"text"},{"text":"The event is always forwarded to the child; there is no way to intercept or veto it, and","type":"text"},{"text":" ","type":"text"},{"text":"none is needed — by the time a parent’s ancestors get a look, the child has already safely","type":"text"},{"text":" ","type":"text"},{"text":"applied the event to itself, so a parent reaction that goes on to destroy or replace that","type":"text"},{"text":" ","type":"text"},{"text":"child subtree can never race with a stale event still being delivered into it. That race","type":"text"},{"text":" ","type":"text"},{"text":"(and the ","type":"text"},{"type":"codeVoice","code":"SubstateOutcome.intercept"},{"text":" case that existed solely to guard against it) doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"exist in this ordering.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"parentState"},{"text":" is read-only — ","type":"text"},{"type":"codeVoice","code":"updateSubstate"},{"text":" decides, it never mutates. To react, return a","type":"text"},{"text":" ","type":"text"},{"text":"delegated ","type":"text"},{"type":"codeVoice","code":"When"},{"text":"; it is sent to the parent’s own ","type":"text"},{"type":"codeVoice","code":"update()"},{"text":", the only place ","type":"text"},{"type":"codeVoice","code":"State"},{"text":" is ever","type":"text"},{"text":" ","type":"text"},{"text":"mutated and the only place a reaction can also enqueue effects. Return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for no reaction.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Example:"}]},{"type":"codeListing","syntax":"swift","code":["@Reducer","struct ParentReducer: MiddlewareReducer {","    struct State: Injectable {","        @SubState var child: ChildReducer.State?","        var delegatedTasks: [String] = []","    }","","    enum When {","        case childDelegated(String)","    }","","    static func updateSubstate<Child: Reducer>(","        _ childType: Child.Type,","        childState: Child.State,","        childWhen: Child.When,","        parentState: State,","        dependencies: ReducerDependencies","    ) throws -> When? {","        \/\/ Child.State and Child.When are tied — both belong to the same Reducer","        guard let when = childWhen as? ChildReducer.When else { return nil }","        switch when {","        case .taskCompleted(let task):","            return .childDelegated(task)","        }","    }","","    static func update(_ when: When, state: inout State, ...) throws {","        switch when {","        case .childDelegated(let task):","            state.delegatedTasks.append(task)","        }","    }","}"]}]}],"metadata":{"role":"symbol","title":"MiddlewareReducer","roleHeading":"Protocol","modules":[{"name":"Statoscope"}],"navigatorTitle":[{"text":"MiddlewareReducer","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MiddlewareReducer","kind":"identifier"}],"externalID":"s:10Statoscope17MiddlewareReducerP","symbolKind":"protocol"},"identifier":{"url":"doc:\/\/Statoscope\/documentation\/Statoscope\/MiddlewareReducer","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Protocol for Reducers that want to react to child scope events"}],"variants":[{"paths":["\/documentation\/statoscope\/middlewarereducer"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"identifiers":["doc:\/\/Statoscope\/documentation\/Statoscope\/MiddlewareReducer\/State","doc:\/\/Statoscope\/documentation\/Statoscope\/MiddlewareReducer\/When"],"generated":true,"title":"Associated Types","anchor":"Associated-Types"},{"identifiers":["doc:\/\/Statoscope\/documentation\/Statoscope\/MiddlewareReducer\/updateSubstate(_:childState:childWhen:parentState:dependencies:)"],"generated":true,"title":"Type Methods","anchor":"Type-Methods"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Statoscope\/documentation\/Statoscope"]]},"sections":[],"references":{"doc://Statoscope/documentation/Statoscope/MiddlewareReducer/updateSubstate(_:childState:childWhen:parentState:dependencies:)":{"title":"updateSubstate(_:childState:childWhen:parentState:dependencies:)","kind":"symbol","identifier":"doc:\/\/Statoscope\/documentation\/Statoscope\/MiddlewareReducer\/updateSubstate(_:childState:childWhen:parentState:dependencies:)","required":true,"url":"\/documentation\/statoscope\/middlewarereducer\/updatesubstate(_:childstate:childwhen:parentstate:dependencies:)","type":"topic","abstract":[{"type":"text","text":"Called AFTER a child scope’s own "},{"type":"codeVoice","code":"update()"},{"type":"text","text":" has processed an event."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"updateSubstate","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Child","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"Child","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"childState","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Child","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"State","kind":"typeIdentifier","preciseIdentifier":"s:10Statoscope7ReducerP5StateQa"},{"text":", ","kind":"text"},{"text":"childWhen","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Child","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"When","kind":"typeIdentifier","preciseIdentifier":"s:10Statoscope7ReducerP4WhenQa"},{"text":", ","kind":"text"},{"text":"parentState","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"State","kind":"typeIdentifier","preciseIdentifier":"s:10Statoscope17MiddlewareReducerP5StateQa"},{"text":", ","kind":"text"},{"text":"dependencies","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"ReducerDependencies","kind":"typeIdentifier","preciseIdentifier":"s:10Statoscope19ReducerDependenciesP"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"When","kind":"typeIdentifier","preciseIdentifier":"s:10Statoscope17MiddlewareReducerP4WhenQa"},{"text":"?","kind":"text"}],"role":"symbol