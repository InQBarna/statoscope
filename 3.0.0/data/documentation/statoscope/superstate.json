on."}]},{"type":"paragraph","inlineContent":[{"text":"The property is ","type":"text"},{"inlineContent":[{"text":"read-only","type":"text"}],"type":"strong"},{"text":": assigning ","type":"text"},{"code":"state.parent = ...","type":"codeVoice"},{"type":"text","text":" is a compile-time error,"},{"type":"text","text":" "},{"type":"text","text":"enforcing the pattern that only the parent reducer mutates parent state."}]},{"text":"Usage:","anchor":"Usage","type":"heading","level":2},{"type":"codeListing","syntax":"swift","code":["@Reducer","struct ChildReducer {","    struct State {","        @SuperState var parent: ParentReducer.State","        var value: Int = 0","    }","","    static func update(_ when: When, state: inout State, ...) throws {","        state.value = state.parent.count * 2  \/\/ read-only snapshot access","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"Value","type":"codeVoice"},{"type":"text","text":" must conform to "},{"code":"Injectable","type":"codeVoice"},{"type":"text","text":" so the framework can produce a default when"},{"type":"text","text":" "},{"type":"text","text":"the child store is not yet wired to a parent."}]}]}],"sections":[],"metadata":{"role":"symbol","modules":[{"name":"Statoscope"}],"externalID":"s:10Statoscope10SuperStateV","symbolKind":"struct","navigatorTitle":[{"text":"SuperState","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SuperState"}],"title":"SuperState","roleHeading":"Structure"},"references":{"doc://Statoscope/documentation/Statoscope/SuperState/init(injectedValue:)":{"url":"\/documentation\/statoscope\/superstate\/init(injectedvalue:)","role":"symbol","type":"topic","abstract":[{"text":"Framework injection initializer. Captures ","type":"text"},{"code":"injectedValue","type":"codeVoice"},{"text":" by value (a snapshot).","type":"text"}],"title":"init(injectedValue:)","identifier":"doc:\/\/Statoscope\/documentation\/Statosco