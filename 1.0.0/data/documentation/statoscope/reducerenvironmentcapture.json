{"kind":"symbol","metadata":{"symbolKind":"struct","navigatorTitle":[{"text":"ReducerEnvironmentCapture","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ReducerEnvironmentCapture"}],"title":"ReducerEnvironmentCapture","externalID":"s:10Statoscope25ReducerEnvironmentCaptureV","roleHeading":"Structure","modules":[{"name":"Statoscope"}],"role":"symbol"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ReducerEnvironmentCapture","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"ObservableObject","kind":"typeIdentifier","preciseIdentifier":"s:7Combine16ObservableObjectP"},{"text":", ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"The problem this solves","anchor":"The-problem-this-solves","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"SwiftUI detaches lazily-evaluated presentation content — a ","type":"text"},{"type":"codeVoice","code":"NavigationLink"},{"text":" destination,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".navigationDestination"},{"text":", ","type":"text"},{"code":".sheet","type":"codeVoice"},{"text":", ","type":"text"},{"code":".fullScreenCover","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":".popover"},{"text":", and similar — from the","type":"text"},{"text":" ","type":"text"},{"text":"enclosing view hierarchy for environment-propagation purposes. An ","type":"text"},{"code":"@EnvironmentObject","type":"codeVoice"},{"text":" ","type":"text"},{"text":"injected between the presenting view’s ancestor and the presentation call site is NOT","type":"text"},{"text":" ","type":"text"},{"text":"visible inside that lazy closure: resolving ","type":"text"},{"code":"@EnvironmentObject","type":"codeVoice"},{"text":" there crashes with","type":"text"},{"text":" ","type":"text"},{"text":"“No ObservableObject of type X found.” This isn’t specific to any one presentation API —","type":"text"},{"text":" ","type":"text"},{"text":"it’s the same failure for all of them, because the root cause (lazy evaluation detaching","type":"text"},{"text":" ","type":"text"},{"text":"the closure’s rendering context) is the same.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Resolving the environment object here, in a normal (non-lazy) ","type":"text"},{"code":"body","type":"codeVoice"},{"text":", and passing the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"already-resolved value into "},{"type":"codeVoice","code":"content"},{"type":"text","text":" by direct reference sidesteps the lookup entirely —"},{"type":"text","text":" "},{"type":"text","text":"nothing inside "},{"code":"content","type":"codeVoice"},{"text":" ever needs to resolve ","type":"text"},{"code":"@EnvironmentObject","type":"codeVoice"},{"text":" itself, no matter how","type":"text"},{"text":" ","type":"text"},{"text":"lazily SwiftUI evaluates it.","type":"text"}]},{"text":"Where this alone is NOT enough","type":"heading","level":2,"anchor":"Where-this-alone-is-NOT-enough"},{"type":"paragraph","inlineContent":[{"text":"Owning the presentation control (rendering as an eager sibling, never nested inside a lazy","type":"text"},{"text":" ","type":"text"},{"text":"closure) is necessary but confirmed (device-tested, multi-level real app) not sufficient on","type":"text"},{"text":" ","type":"text"},{"text":"its own: ","type":"text"},{"code":".navigationDestination","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"NavigationLink","type":"codeVoice"},{"text":" push results are anchored to the","type":"text"},{"text":" ","type":"text"},{"code":"NavigationStack","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"NavigationView","type":"codeVoice"},{"text":" container’s own position, not to wherever the pushing","type":"text"},{"text":" ","type":"text"},{"text":"content is currently nested. An ","type":"text"},{"code":"@EnvironmentObject","type":"codeVoice"},{"text":" resolved here is only reachable if","type":"text"},{"text":" ","type":"text"},{"code":"ReducerEnvironmentCapture","type":"codeVoice"},{"text":" itself renders no deeper than that container — true for a","type":"text"},{"text":" ","type":"text"},{"text":"single level of push navigation, false a few levels down. ","type":"text"},{"type":"codeVoice","code":"_ReducerChildViewConnector"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"built on ","type":"text"},{"code":"ReducerRegistryCapture","type":"codeVoice"},{"text":" instead, which sidesteps this by resolving from a single","type":"text"},{"text":" ","type":"text"},{"text":"root-injected ","type":"text"},{"code":"ReducerStoreRegistry","type":"codeVoice"},{"text":" rather than resolving ","type":"text"},{"code":"S","type":"codeVoice"},{"text":" itself via ","type":"text"},{"code":"@EnvironmentObject","type":"codeVoice"},{"text":" ","type":"text"},{"text":"at whatever depth this renders — see ","type":"text"},{"code":"ReducerStoreRegistry","type":"codeVoice"},{"text":" for why that’s","type":"text"},{"text":" ","type":"text"},{"text":"depth-independent. Kept as a public primitive for single-level cases and any other custom","type":"text"},{"text":" ","type":"text"},{"text":"use; prefer ","type":"text"},{"code":"ReducerRegistryCapture","type":"codeVoice"},{"text":" for anything that might be reached through more than one","type":"text"},{"text":" ","type":"text"},{"text":"level of push navigation.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/Statoscope\/documentation\/Statoscope\/ReducerEnvironmentCapture","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Statoscope\/documentation\/Statoscope"]]},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Resolves an "},{"type":"codeVoice","code":"@EnvironmentObject"},{"type":"text","text":" in its own "},{"type":"codeVoice","code":"body"},{"type":"text","text":" — a normal, eager render context —"},{"type":"text","text":" "},{"type":"text","text":"then hands the already-resolved reference to "},{"type":"codeVoice","code":"content"},{"type":"text","text":" by direct reference."}],"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/Statoscope\/documentation\/Statoscope\/ReducerEnvironmentCapture\/init(_:content:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/Statoscope\/documentation\/Statoscope\/ReducerEnvironmentCapture\/body"]},{"generated":true,"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/Statoscope\/documentation\/Statoscope\/ReducerEnvironmentCapture\/View-Implementations"]}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Statoscope\/s8SendableP","doc:\/\/Statoscope\/s16SendableMetatypeP","doc:\/\/Statoscope\/7SwiftUI4ViewP"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/statoscope\/reducerenvironmentcapture"]}],"references":{"doc://Statoscope/documentation/Statoscope/ReducerEnvironmentCapture/body":{"title":"body","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind