{"hierarchy":{"paths":[["doc:\/\/Statoscope\/documentation\/Statoscope"]]},"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Statoscope\/documentation\/Statoscope\/MiddlewareReducer"},"metadata":{"externalID":"s:10Statoscope17MiddlewareReducerP","role":"symbol","navigatorTitle":[{"text":"MiddlewareReducer","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MiddlewareReducer","kind":"identifier"}],"roleHeading":"Protocol","title":"MiddlewareReducer","modules":[{"name":"Statoscope"}],"symbolKind":"protocol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/statoscope\/middlewarereducer"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MiddlewareReducer","kind":"identifier"}]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"text":"When a Reducer conforms to ","type":"text"},{"type":"codeVoice","code":"MiddlewareReducer"},{"text":", the generated Store class will implement","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HierarchialScopeMiddleWare"},{"text":" and observe events from child scopes.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"updateSubstate"},{"text":" runs ","type":"text"},{"type":"strong","inlineContent":[{"text":"after","type":"text"}]},{"text":" the child’s own ","type":"text"},{"type":"codeVoice","code":"update()"},{"text":" has already processed the event —","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"childState"},{"text":" is the child’s state once that update finished, not a preview of what’s about","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to happen. This mirrors "},{"type":"codeVoice","code":"statoscope-zustand"},{"text":"‘s ","type":"text"},{"type":"codeVoice","code":"onChildAction(action, childState)"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"documents the same thing: “called with the action and the child’s already-updated state.”","type":"text"},{"text":" ","type":"text"},{"text":"The event is always forwarded to the child; there is no way to intercept or veto it, and","type":"text"},{"text":" ","type":"text"},{"text":"none is needed — by the time a parent’s ancestors get a look, the child has already safely","type":"text"},{"text":" ","type":"text"},{"text":"applied the event to itself, so a parent reaction that goes on to destroy or replace that","type":"text"},{"text":" ","type":"text"},{"text":"child subtree can never race with a stale event still being delivered into it. That race","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(and the "},{"type":"codeVoice","code":"SubstateOutcome.intercept"},{"type":"text","text":" case that existed solely to guard against it) doesn’t"},{"type":"text","text":" "},{"text":"exist in this ordering.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"parentState"},{"type":"text","text":" is read-only — "},{"type":"codeVoice","code":"updateSubstate"},{"type":"text","text":" decides, it never mutates. To react, return a"},{"type":"text","text":" "},{"type":"text","text":"delegated "},{"code":"When","type":"codeVoice"},{"text":"; it is sent to the parent’s own ","type":"text"},{"code":"update()","type":"codeVoice"},{"text":", the only place ","type":"text"},{"code":"State","type":"codeVoice"},{"text":" is ever","type":"text"},{"text":" ","type":"text"},{"text":"mutated and the only place a reaction can also enqueue effects. Return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for no reaction.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Example:","type":"text"}]},{"code":["@Reducer","struct ParentReducer: MiddlewareReducer {","    struct State: Injectable {","        @SubState var child: ChildReducer.State?","        var delegatedTasks: [String] = []","    }","","    enum When {","        case childDelegated(String)","    }","","    static func updateSubstate<Child: Reducer>(","        _ childType: Child.Type,","        childState: Child.State,","        childWhen: Child.When,","        parentState: State,","        dependencies: ReducerDependencies","    ) throws -> When? {","        \/\/ Child.State and Child.When are tied — both belong to the same Reducer","        guard let when = childWhen as? ChildReducer.When else { return nil }","        switch when {","        case .taskCompleted(let task):","            return .childDelegated(task)","        }","    }","","    static func update(_ when: When, state: inout State, ...) throws {","        switch when {","        case .childDelegated(let task):","            state.delegatedTasks.append(task)","        }","    }","}"],"syntax":"swift","type":"codeListing"}]}],"abstract":[{"type":"text","text":"Protocol for Reducers that want to react to child scope events"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"identifiers":["doc:\/\/Statoscope\/documentation\/Statoscope\/MiddlewareReducer\/State","doc:\/\/Statoscope\/documentation\/Statoscope\/MiddlewareReducer\/When"],"generated":true,"title":"Associated Types","anchor":"Associated-Types"},{"identifiers":["doc:\/\/Statoscope\/documentation\/Statoscope\/MiddlewareReducer\/updateSubstate(_:childState:childWhen:parentState:dependencies:)"],"generated":true,"title":"Type Methods","anchor":"Type-Methods"}],"references":{"doc://Statoscope/documentation/Statoscope/MiddlewareReducer/updateSubstate(_:childState:childWhen:parentState:dependencies:)":{"kind":"symbol","required":true,"identifier":"doc:\/\/Statoscope\/documentation\/Statoscope\/MiddlewareReducer\/updateSubstate(_:childState:childWhen:parentState:dependencies:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"updateSubstate"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Child"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"Child"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"childState"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Child"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"State","preciseIdentifier":"s:10Statoscope7ReducerP5StateQa"},{"kind":"text","text":", "},{"kind":"externalParam","text":"childWhen"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Child"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"When","preciseIdentifier":"s:10Statoscope7ReducerP4WhenQa"},{"kind":"text","text":", "},{"kind":"externalParam","text":"parentState"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"State","preciseIdentifier":"s:10Statoscope17MiddlewareReducerP5StateQa"},{"kind":"text","text":", "},{"kind":"externalParam","text":"dependencies"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","text":"ReducerDependencies","preciseIdentifier":"s:10Statoscope19ReducerDependenciesP"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"When","preciseIdentifier":"s:10Statoscope17MiddlewareReducerP4WhenQa"},{"kind":"text","text":"?"}],"title":"updateSubstate(_:childState:childWhen:parentState:dependencies:)","abstract":[{"type":"text","text":"Called AFTER a child scope’s own "},{"type":"codeVoice","code":"update()"},{"type":"text","text":" has processed an event."}],"url":"\/documentation\/statoscope\/middlewarereducer\/updatesubstate(_:childstate:childwhen:parentstate:dependencies:)"},"doc://Statoscope/documentation/Statoscope/MiddlewareReducer/When":{"kind":"symbol","required":true,"identifier":"doc:\/\/Statoscope\/documentation\/Statoscope\/MiddlewareReducer\/When","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"When"}],"title":"When","abstract":[],"url":"\/documentation\/statoscope\/middlewarereducer\/when"},"doc://Statoscope/documentation/Statoscope":{"kind":"symbol","role":"collection","identifier":"doc:\/\/Statoscope\/documentation\/Statoscope","type":"topic","title":"Statoscope","abstract":[{"text":"A lightweight library for managing state in iOS applications, designed with simplicity, testability, and scalability in mind.","type":"text"}],"url":"\/documentation\/statoscope"},"doc://Statoscope/documentation/Statoscope/MiddlewareReducer/State":{"kind":"symbol","required":true,"identifier":"doc:\/\/Statoscope\/documentation\/Statoscope\/MiddlewareReducer\/State","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"State"}],"title":"State","abstract":[],"url":"\/documentation\/statoscope\/middlewarereducer\/state"},"doc://Statoscope/documentation/Statoscope/MiddlewareReducer":{"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MiddlewareReducer","kind":"identifier"}],"identifier":"doc:\/\/Statoscope\/documentation\/Statoscope\/MiddlewareReducer","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MiddlewareReducer","kind":"identifier"}],"title":"MiddlewareReducer","abstract":[{"text":"Protocol for Reducers that want to react to child scope events","type":"text"}],"url":"\/documentation\/statoscope\/middlewarereducer","type":"topic"}}}