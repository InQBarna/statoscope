ameters"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Please note enqueueing an effect is just adding it to a list of pending effects. Does not","type":"text"},{"text":" ","type":"text"},{"text":"immediately trigger it. However EffectsState is provided in the update method and right","type":"text"},{"text":" ","type":"text"},{"text":"after method is completed, the enqueued effects will be triggered","type":"text"}],"type":"paragraph"},{"text":"Usage","anchor":"Usage","level":3,"type":"heading"},{"inlineContent":[{"text":"Use it with an anonymous Effect","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["effectsController.enqueue(","  AnyEffect {","    let resultDTO = try JSONDecoder().decode(DTO.self, from: try await URLSession.shared.data(for: request).0)","    return When.networkPostCompleted(resultDTO)","  }",")"],"type":"codeListing"},{"inlineContent":[{"text":"Or created a typed Effect","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct NetworkEffect<Response: Decodable>: Effect {","  let request: URLRequest","  func runEffect() async throws -> Response {","    try JSONDecoder().decode(Response.self, from: try await URLSession.shared.data(for: request).0)","  }","}"],"type":"codeListing"},{"inlineContent":[{"text":"And use it mapping the result to your When case","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["effectsController.enqueue(","  let url = URL(string: \"http:\/\/statoscope.com\")!","  var request = URLRequest(url: url)","  request.setValue(\"application\/json\", forHTTPHeaderField: \"Content-Type\")","  request.httpMethod = \"POST\"","  request.httpBody = try JSONEncoder().encode(dto)","  return NetworkEffect(request)","     .map(When.networkPostCompleted)",")"],"type":"codeListing"}]}],"identifier":{"url":"doc:\/\/Statoscope\/documentation\/Statoscope\/EffectsState\/enqueue(_:)","interfaceLanguage":"swift"},"hierarchy":{"p