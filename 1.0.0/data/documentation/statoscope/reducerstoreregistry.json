{"hierarchy":{"paths":[["doc:\/\/Statoscope\/documentation\/Statoscope"]]},"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Statoscope\/documentation\/Statoscope\/ReducerStoreRegistry"},"metadata":{"role":"symbol","title":"ReducerStoreRegistry","roleHeading":"Class","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ReducerStoreRegistry","kind":"identifier"}],"modules":[{"name":"Statoscope"}],"externalID":"s:10Statoscope20ReducerStoreRegistryC","navigatorTitle":[{"kind":"identifier","text":"ReducerStoreRegistry"}],"symbolKind":"class"},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Statoscope\/7Combine16ObservableObjectP"],"type":"conformsTo","title":"Conforms To"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/statoscope\/reducerstoreregistry"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ReducerStoreRegistry"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Why this exists","anchor":"Why-this-exists"},{"type":"paragraph","inlineContent":[{"text":"Each level of a ","type":"text"},{"code":"@Reducer","type":"codeVoice"},{"text":" parent-child tree renders its own content via","type":"text"},{"text":" ","type":"text"},{"code":"_ReducerChildObservingView","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"ReducerObservedView","type":"codeVoice"},{"text":", which injects ","type":"text"},{"code":".environmentObject(store)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"wherever ","type":"text"},{"inlineContent":[{"text":"that level","type":"text"}],"type":"emphasis"},{"text":" happens to render. For a single level of push navigation this is","type":"text"},{"text":" ","type":"text"},{"text":"enough — but confirmed (device-tested, multi-level real app) to fail once a destination is","type":"text"},{"text":" ","type":"text"},{"text":"reached through more than one nested push: ","type":"text"},{"code":".navigationDestination","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"NavigationLink","type":"codeVoice"},{"text":" push","type":"text"},{"text":" ","type":"text"},{"text":"results are anchored to the ","type":"text"},{"code":"NavigationStack","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"NavigationView","type":"codeVoice"},{"text":" container’s own position, not","type":"text"},{"text":" ","type":"text"},{"text":"to wherever the pushing content is currently nested, so an ","type":"text"},{"code":"@EnvironmentObject","type":"codeVoice"},{"text":" injected","type":"text"},{"text":" ","type":"text"},{"text":"several levels below that container is invisible to the destination regardless of ","type":"text"},{"inlineContent":[{"text":"how","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"the destination resolves it (owning the presentation control locally, as","type":"text"},{"text":" ","type":"text"},{"code":"_ReducerChildPresentingConnector","type":"codeVoice"},{"text":" used to, does not help — the injection point itself is","type":"text"},{"text":" ","type":"text"},{"text":"too deep).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The fix: inject exactly one thing at the true root — above\/at the ","type":"text"},{"code":"NavigationStack","type":"codeVoice"},{"text":" ","type":"text"},{"text":"container, never any deeper — and have every level register itself into ","type":"text"},{"inlineContent":[{"text":"that","type":"text"}],"type":"emphasis"},{"text":" instead of","type":"text"},{"text":" ","type":"text"},{"text":"adding its own environment injection. Resolving ","type":"text"},{"code":"ReducerStoreRegistry","type":"codeVoice"},{"text":" itself via","type":"text"},{"text":" ","type":"text"},{"code":"@EnvironmentObject","type":"codeVoice"},{"text":" always succeeds, at any depth, because its injection point never","type":"text"},{"text":" ","type":"text"},{"text":"moves; it isn’t a value being carried through a level-specific injection the way each","type":"text"},{"text":" ","type":"text"},{"text":"individual store was.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Keyed by concrete store type (","type":"text"},{"code":"ObjectIdentifier(S.self)","type":"codeVoice"},{"text":") with a stack of weak references","type":"text"},{"text":" ","type":"text"},{"text":"per type — a stack so a reducer that navigates to another instance of its own type resolves","type":"text"},{"text":" ","type":"text"},{"text":"to the innermost (currently relevant) one; weak so a store that’s genuinely torn down (its","type":"text"},{"text":" ","type":"text"},{"text":"last strong reference gone, e.g. ","type":"text"},{"code":"state.child = nil","type":"codeVoice"},{"text":") is skipped by ","type":"text"},{"code":"current(_:)","type":"codeVoice"},{"text":" without","type":"text"},{"text":" ","type":"text"},{"text":"needing an explicit removal call.","type":"text"}]},{"type":"heading","level":2,"text":"Why there’s no `pop`","anchor":"Why-theres-no-pop"},{"type":"paragraph","inlineContent":[{"text":"An earlier revision removed a registered store on ","type":"text"},{"code":".onDisappear","type":"codeVoice"},{"text":". ","type":"text"},{"inlineContent":[{"text":"Confirmed on device","type":"text"}],"type":"strong"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"during a nested push (a destination pushing its own child destination), SwiftUI can fire","type":"text"},{"text":" ","type":"text"},{"code":".onDisappear","type":"codeVoice"},{"text":" for a view that’s still logically part of the stack — without ever firing a","type":"text"},{"text":" ","type":"text"},{"text":"matching ","type":"text"},{"code":".onAppear","type":"codeVoice"},{"text":" afterward — as part of its path reconciliation for the nested","type":"text"},{"text":" ","type":"text"},{"text":"transition. Acting on that ","type":"text"},{"code":".onDisappear","type":"codeVoice"},{"text":" permanently removed a store that was still very","type":"text"},{"text":" ","type":"text"},{"text":"much alive and still rendering, and nothing ever re-registered it, leaving every subsequent","type":"text"},{"text":" ","type":"text"},{"text":"lookup for it ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (symptom: the screen goes blank right as the nested push settles).","type":"text"},{"text":" ","type":"text"},{"code":"push","type":"codeVoice"},{"text":" is idempotent and safe to call on every ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" evaluation (not just ","type":"text"},{"code":".onAppear","type":"codeVoice"},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"text":"weak references mean a truly-gone store silently drops out of ","type":"text"},{"code":"current(_:)","type":"codeVoice"},{"text":" on its own —","type":"text"},{"text":" ","type":"text"},{"text":"so there’s nothing left for an explicit ","type":"text"},{"code":"pop","type":"codeVoice"},{"text":" to do that isn’t already handled, and removing","type":"text"},{"text":" ","type":"text"},{"text":"it removes the SwiftUI-lifecycle-timing risk entirely.","type":"text"}]}]}],"abstract":[{"type":"text","text":"A stack of live stores per concrete store type, injected exactly "},{"type":"strong","inlineContent":[{"text":"once","type":"text"}]},{"text":" at the app’s","type":"text"},{"type":"text","text":" "},{"text":"root by ","type":"text"},{"type":"codeVoice","code":"ReducerStoreView"},{"text":", so any navigation destination — at any nesting depth — can","type":"text"},{"text":" ","type":"text"},{"text":"resolve its own live parent store without depending on that specific level’s own","type":"text"},{"text":" ","type":"text"},{"code":"@EnvironmentObject","type":"codeVoice"},{"type":"text","text":" injection being reachable."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"identifiers":["doc:\/\/Statoscope\/documentation\/Statoscope\/ReducerStoreRegistry\/init()"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/Statoscope\/documentation\/Statoscope\/ReducerStoreRegistry\/ObservableObject-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"references":{"doc://Statoscope/7Combine16ObservableObjectP":{"type":"unresolvable","identifier":"doc:\/\/Statoscope\/7Combine16ObservableObjectP","title":"Combine.ObservableObject"},"doc://Statoscope/documentation/Statoscope/ReducerStoreRegistry/ObservableObject-Implementations":{"kind":"article","role":"collectionGroup","identifier":"doc:\/\/Statoscope\/documentation\/Statoscope\/ReducerStoreRegistry\/ObservableObject-Implementations","type":"topic","title":"ObservableObject Implementations","abstract":[],"url":"\/documentation\/statoscope\/reducerstoreregistry\/observableobject-implementations"},"doc://Statoscope/documentation/Statoscope/ReducerStoreRegistry":{"title":"ReducerStoreRegistry","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ReducerStoreRegistry","kind":"identifier"}],"url":"\/documentation\/statoscope\/reducerstoreregistry","abstract":[{"text":"A stack of live stores per concrete store type, injected exactly ","type":"text"},{"type":"strong","inlineContent":[{"text":"once","type":"text"}]},{"text":" at the app’s","type":"text"},{"text":" ","type":"text"},{"text":"root by ","type":"text"},{"code":"ReducerStoreView","type":"codeVoice"},{"text":", so any navigation destination — at any nesting depth — can","type":"text"},{"text":" ","type":"text"},{"text":"resolve its own live parent store without depending on that specific level’s own","type":"text"},{"text":" ","type":"text"},{"code":"@EnvironmentObject","type":"codeVoice"},{"text":" injection being reachable.","type":"text"}],"navigatorTitle":[{"text":"ReducerStoreRegistry","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Statoscope\/documentation\/Statoscope\/ReducerStoreRegistry"},"doc://Statoscope/documentation/Statoscope/ReducerStoreRegistry/init()":{"title":"init()","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"url":"\/documentation\/statoscope\/reducerstoreregistry\/init()","abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/Statoscope\/documentation\/Statoscope\/ReducerStoreRegistry\/init()"},"doc://Statoscope/documentation/Statoscope":{"kind":"symbol","role":"collection","identifier":"doc:\/\/Statoscope\/documentation\/Statoscope","type":"topic","title":"Statoscope","abstract":[{"text":"A lightweight library for managing state in iOS applications, designed with simplicity, testability, and scalability in mind.","type":"text"}],"url":"\/documentation\/statoscope"}}}